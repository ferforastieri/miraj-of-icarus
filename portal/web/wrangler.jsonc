{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miraj-of-icarus-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "miraj-of-icarus-portal"
    }
  ],
  "vars": {
    "MIRAJ_OF_ICARUS_API_INTERNAL_URL": "https://api.mirajoficarus.com"
  },
  "routes": [
    {
      "pattern": "mirajoficarus.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
