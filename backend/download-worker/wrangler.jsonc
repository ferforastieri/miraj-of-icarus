{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miraj-of-icarus-downloads",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "miraj-of-icarus-releases"
    }
  ],
  "ratelimits": [
    {
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "21001",
      "simple": {
        "limit": 100,
        "period": 10
      }
    }
  ],
  "routes": [
    {
      "pattern": "downloads.mirajoficarus.com",
      "custom_domain": true
    }
  ],
  "observability": { "enabled": true }
}
